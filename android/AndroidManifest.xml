<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sprocontrol.k2"
    android:versionCode="8"
    android:versionName="1.0.5">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34" />

    <!-- Bluetooth only. There is no INTERNET permission: the app cannot send anything anywhere.
         ACCESS_FINE_LOCATION is requested just-in-time, only when no bonded K2 exists and a scan is needed
         (ColorOS drops the K2's adverts for apps that disavow location). -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Network only for the update check the user starts from Settings: one HTTPS request to GitHub's API and,
         if accepted, the APK download from GitHub. The page itself is served from assets and cannot use it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application android:label="SproCtrl" android:icon="@mipmap/ic_launcher" android:theme="@android:style/Theme.Black.NoTitleBar"
        android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Serves the downloaded update to the package installer; nothing else can open it. -->
        <provider android:name=".ApkProvider" android:authorities="com.sprocontrol.k2.apk"
            android:exported="false" android:grantUriPermissions="true" />
        <!-- Not exported: only the system (widget host, AlarmManager) and our own PendingIntents reach it. -->
        <service android:name=".LinkService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <receiver android:name=".K2Widget" android:exported="false" android:label="SproCtrl">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/k2_widget" />
        </receiver>
        <receiver android:name=".K2OneWidget" android:exported="false" android:label="SproCtrl button">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/k2_one_widget" />
        </receiver>
    </application>
</manifest>
