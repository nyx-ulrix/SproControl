<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, one row: name + status on the left; the controls (timer, brew buttons or search)
     centred in the space between where the text ends and the widget's right edge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!-- A fixed-height bar centred in the cell: launcher cells are often much taller than one row. -->
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:layout_gravity="center_vertical"
    android:background="@drawable/widget_bg">

<ImageView
    android:id="@+id/wlow"
    android:layout_width="8dp"
    android:layout_height="8dp"
    android:layout_gravity="top|end"
    android:layout_margin="7dp"
    android:contentDescription="Battery low"
    android:src="@drawable/dot_red"
    android:visibility="gone" />

<LinearLayout
    android:id="@+id/wroot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/werr"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Machine warning"
        android:src="@drawable/ic_warn"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/wtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="150dp"
            android:singleLine="true"
            android:text="Ikape K2"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wstat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="150dp"
            android:singleLine="true"
            android:text="--"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wctl"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <Chronometer
            android:id="@+id/wtimer"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/wextract"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Extract"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_extract" />

        <ImageButton
            android:id="@+id/wboth"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Heat and extract"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_both" />

        <ImageButton
            android:id="@+id/wpurge"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Purge: 30 seconds of water, no heating"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_purge" />

        <ProgressBar
            android:id="@+id/wbusy"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/wopen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Search for the K2"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
</FrameLayout>
